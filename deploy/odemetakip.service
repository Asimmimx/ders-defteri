[Unit]
Description=Odeme Takip (Flask/gunicorn)
After=network.target

[Service]
Type=simple
User=odemetakip
Group=odemetakip
WorkingDirectory=/opt/odemetakip
EnvironmentFile=/opt/odemetakip/.env
ExecStart=/opt/odemetakip/.venv/bin/gunicorn --workers 1 --threads 4 --bind 127.0.0.1:8098 --access-logfile - wsgi:app
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true
ReadWritePaths=/var/lib/odemetakip

[Install]
WantedBy=multi-user.target
